{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TestX",
  "version": "0.1.12",
  "identifier": "com.excelsecu.testx",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "TestX",
        "width": 1200,
        "height": 800,
        "url": "index.html",
        "devtools": true,
        "maximized": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "process": {
      "active": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/sekfung/TestX/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
